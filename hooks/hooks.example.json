{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep|Glob|WebSearch|WebFetch|NotebookRead|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/post_tool_output.py",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/post_tool_use.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/post_tool_output.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/post_tool_output.py",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/post_tool_output.py",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /ABSOLUTE/PATH/TO/FidelityFlow/hooks/session_start.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
